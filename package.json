{
  "name": "bmclinic-co",
  "version": "1.1.0",
  "private": true,
  "description": "bmclinic.co — Next.js 15 Flagship Medical Website (Medycyna Estetyczna, Flebologia, Proktologia, Chirurgia Ogólna) + 3D Digital Twin & VI HRTF Wayfinding + 6-Param LiDAR Analyzer + AI SEO/Conversion Engine",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "model:generate": "node scripts/generate-page-model.mjs",
    "model:seed-all": "node scripts/generate-page-model.mjs --seed-all",
    "db:init": "python3 bmclinic_db_engine.py",
    "vercel:preview": "vercel build && vercel deploy --prebuilt",
    "vercel:stage-prod": "vercel build --prod && vercel deploy --prebuilt --prod --skip-domain"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.0"
  }
}
