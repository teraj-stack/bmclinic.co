# Local default; use the real HTTPS domain in production.
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
# Generate and set privately. Do not commit actual values.
ADMIN_PASSWORD=
SESSION_SECRET=
DATABASE_PATH=data/clinic.sqlite
# Optional. Never invent clinic data.
BOOKING_URL=
CLINIC_PHONE=
CLINIC_EMAIL=
CLINIC_ADDRESS=

# Patient forms are disabled until all settings are supplied privately.
PATIENT_INTAKE_ENABLED=false
PATIENT_DATABASE_PATH=data/patient-intake.sqlite
# 32 random bytes encoded as 64 hexadecimal characters. Back up separately.
PATIENT_DATA_KEY=
# Base32 TOTP secret (32–64 characters); provision privately in staff authenticator.
PATIENT_STAFF_TOTP_SECRET=
PATIENT_STAFF_NAME=
# Absolute path to approved, complete clinic privacy notice, mounted at runtime.
PATIENT_NOTICE_PATH=
PATIENT_NOTICE_VERSION=
